# Copy to .env for local development. Every variable is optional — the app is
# fully playable with none of them set (see docs/ARCHITECTURE.md §8).
#
# NEVER commit a real .env. Values are injected in CI from repository secrets,
# which keeps them out of git history — but note that anything prefixed VITE_
# is compiled into the public bundle and is therefore readable by anyone.

# --- Movies (optional) ---
# Free non-commercial key from https://www.themoviedb.org/settings/api
# Without it, the movies category serves a bundled offline snapshot.
# TMDB keys cannot be domain-restricted; the key is public once deployed.
VITE_TMDB_KEY=

# --- Restaurants: enhanced mode (optional) ---
# Google Places API (New). Unlocks star ratings and real photos.
# MUST be restricted before deploying:
#   1. Application restriction: HTTP referrers -> https://<user>.github.io/*
#   2. API restriction: Places API (New) only
#   3. A hard quota cap and a billing alert in the Google Cloud console
# Without it, restaurants fall back to OpenStreetMap (free, keyless, no ratings).
VITE_GOOGLE_PLACES_KEY=

# --- Group mode across devices (optional) ---
# Firebase Realtime Database, Spark (free) plan, region europe-west1.
# Without these, group rounds run on the built-in demo adapter, which syncs
# only between tabs on one device.
# This config is public by design; security comes from firebase/database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
