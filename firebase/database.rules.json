{
  "rules": {
    "sessions": {
      "$sid": {
        ".read": "auth != null",

        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid)",
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|active|matched|exhausted|expired)$/)"
          },
          "hostId": {
            ".validate": "!data.exists() || data.val() === newData.val()"
          },
          "$other": { ".validate": true }
        },

        "deck": {
          ".write": "auth != null && root.child('sessions/' + $sid + '/meta/hostId').val() === auth.uid && !data.exists()",
          ".validate": "newData.hasChildren()"
        },

        "participants": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "progress": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "done": { ".validate": "newData.isBoolean()" },
            "online": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "likes": {
          "$cardId": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid && !data.exists() && root.child('sessions/' + $sid + '/meta/status').val() === 'active' && root.child('sessions/' + $sid + '/participants/' + $uid).exists()",
              ".validate": "newData.isBoolean() && newData.val() === true"
            }
          }
        },

        "winner": {
          ".write": "auth != null && !data.exists() && root.child('sessions/' + $sid + '/participants/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['cardId', 'decidedAt', 'byUid'])",
          "byUid": { ".validate": "newData.val() === auth.uid" },
          "$other": { ".validate": true }
        }
      }
    }
  }
}
